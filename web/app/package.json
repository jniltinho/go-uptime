{
  "name": "go-uptime",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue src",
    "test:unit": "node --test src/utils/*.test.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.0",
    "lucide-vue-next": "^0.539.0",
    "marked": "^16.4.1",
    "tailwind-merge": "^3.3.1",
    "vue": "^3.5.18",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "^3.5.18",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.28.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.1.8",
    "vite": "^8.3.6",
    "@vitejs/plugin-vue": "^6.0.10"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "requireConfigFile": false,
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "vue/multi-word-component-names": [
        "error",
        {
          "ignores": [
            "Home",
            "Details",
            "Loading",
            "Settings",
            "Social",
            "Tooltip",
            "Pagination",
            "Button",
            "Badge",
            "Card",
            "Input",
            "Select"
          ]
        }
      ]
    },
    "globals": {
      "defineProps": "readonly",
      "defineEmits": "readonly",
      "defineExpose": "readonly",
      "withDefaults": "readonly"
    }
  },
  "browserslist": [
    "defaults",
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
